# ---------------------------------------------------------------------------
# Private real data & anything that lets outsiders infer it
# (verification / train / inference CODE and synthetic fixtures stay tracked)
# ---------------------------------------------------------------------------
# Ignore private inputs, but keep the panel_extract scaffold README tracked.
input/*
!input/panel_extract/
input/panel_extract/**
!input/panel_extract/README.md
check_reference/

# Filled gold for private benchmark cases (paths, real n, identifiable panel maps).
# Keep *.example.json, README, and synthetic fixtures/gold/demo/ committed.
fixtures/gold/private_benchmark/case_manifest.json
fixtures/gold/private_benchmark/gold_warnings.json
fixtures/gold/private_benchmark/panel_extract_gold.json
fixtures/gold/private/
# Thin extra-paper extract cases: filled gold/draft only (examples stay tracked).
fixtures/gold/panel_extract/*/panel_extract_gold.json
fixtures/gold/panel_extract/*/panel_extract_draft.json
fixtures/gold/panel_extract/*/panel_labels_gold.json
fixtures/gold/panel_extract/*/panel_boxes_gold.json
fixtures/gold/panel_extract/*/case_manifest.json
# Legend n ↔ data n gold for input/data extract papers (real paths and n).
fixtures/gold/data_extract/*/legend_data_gold.json

# Optional local case notes derived from private manuscripts
docs/private/

# Local case vocabulary profile (experiment-side tokens of private benchmark cases)
rules/local_case_profile.json

# Tests that only run against private benchmark data
tests/private/

# Local developer handoff (may name private cases / paths).
handoff.md
pegasus-handover/

# Jupyter
.ipynb_checkpoints/
