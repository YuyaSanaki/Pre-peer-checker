    "quant_fig1c_xlsx": "Manuscript/data/Fig1C/quant_condition_A.xlsx",
    "quant_fig1h_xlsx": "Manuscript/data/Fig1H/quant_condition_B.xlsx",
    "plot_residue_dir": "Manuscript/data/Fig1/plot_residue",
