    "condition_b": {
      "source": "quant_fig1h_xlsx",
      "sheet": "graph",
      "value_col": "value",
      "label_col": "label",
      "groups": [
        {"label": 1, "genotype": "control", "panel_group": "N", "n_expected_from_data": null},
        {"label": 2, "genotype": "knockdown", "panel_group": "O", "n_expected_from_data": null}
      ]
    }
  },
  "eval_command": {
    "verify": "pre-peer-checker input/CASE_ID_PLACEHOLDER -o outputs/report.html --json outputs/warnings.json",
    "gold": "python -m pre_peer_checker.eval.gold_eval --case CASE_ID_PLACEHOLDER --warnings outputs/warnings.json"
