{
  "schema_version": "1.4",
  "purpose": "生命科学論文一般に適用する検知パターン。特定論文パスに依存しない。benchmark ケース（private_benchmark 等）は pattern_id でここに紐づける。研究公正文献・人手キュレーション由来の類型も含む。",
  "product_goal": "配布により広く投稿前検証を行い、研究公正上・PubPeer 上で問題視されやすい不整合を未然に防ぐ。開発用の過去事例・実データは評価と回帰のためであり、エンジンの適用範囲をそれに限定しない。",
  "catalog_policy": {
    "sources": [
      "retraction_watch_crossref",
      "ori_case_summaries",
      "cope_case_database",
      "literature",
      "curated_pubpeer",
      "check_reference",
      "benchmark"
    ],
    "absolute_rules": [
      "no_verbatim_expression: コメント原文・長い引用・PDF/図の再配布（git/Issue/PR/配布物）をしない",
      "abstract_to_inspection_spec: abstract_rule / pattern_id / Warning タグのみ。有罪断定・告発文は入れない",
      "no_commenter_targeting: コメント者の名指し・攻撃をしない。カタログは方法論"
    ],
    "forbidden": [
      "pubpeer_automated_scrape",
      "guilt_score_ml",
      "verbatim_comment_corpora",
      "retracted_paper_figures_in_git",
      "pdf_or_comment_text_in_git_issue_pr",
      "naming_or_attacking_commenters_in_catalog"
    ],
    "rule_store": "fixtures/patterns/pubpeer_patterns.json",
