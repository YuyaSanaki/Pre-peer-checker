{
  "schema_version": "1.1",
  "role": "lightglue_threshold_calibration",
  "device": "cuda",
  "date": "2026-09-26",
  "extractor": "SuperPoint max_num_keypoints=1024 + LightGlue",
  "must_pos_min": 153,
